+void Device::bind_gen_double(const QString &name, int decimals, QString suffix,
+	double min, double max, double step,
+	Property::Getter getter, Property::Setter setter)
+{
+	assert(configurable_);
+
+	properties_.push_back(shared_ptr<Property>(new Double(name, "", decimals,
+		suffix, pair<double, double>(min, max), step, getter, setter)));
+}
